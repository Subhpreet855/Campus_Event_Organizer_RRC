generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER MODEL
// We store Clerk's user ID so backend can link data to a user
model User {
  id          Int      @id @default(autoincrement())
  clerkUserId String   @unique   // Clerk user identifier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation: One user can create many events
  events      Event[]
}

// CATEGORY MODEL
model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  events      Event[]
}

// EVENT MODEL
// Added userClerkId + relation to User
model Event {
  id          Int       @id @default(autoincrement())
  title       String
  date        DateTime
  location    String
  description String

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  // This field is added as Event belongs to a logged-in user
  userId      Int?                    // local FK field
  user        User? @relation(fields: [userId], references: [id])  
  // This is mainly responsible for linking each event to the correct Clerk user.

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// FEATURED EVENT MODEL
model FeaturedEvent {
  id          Int      @id @default(autoincrement())
  name        String
  date        String
  time        String
  location    String
  description String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}